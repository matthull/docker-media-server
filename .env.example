# Your timezone, https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# UNIX PUID and PGID, find with: id $USER
PUID=1000
PGID=1000

# The directory where downloaded data will be stored
MEDIA_ROOT=/mnt/media

# The directory where your app configs will be stored.
# (This can be the same as the MEDIA_ROOT. I prefer to keep my app config and downloads on seperate drives)
CONFIG_ROOT=/opt/config-root

# SSD-backed directory for SABnzbd temporary/incomplete downloads.
# Speeds up unpacking significantly vs spinning disk.
SABNZBD_TEMP=/opt/sabnzbd-temp

# Tailscale auth key — generate at https://login.tailscale.com/admin/settings/keys
# Use a reusable key so the container can re-authenticate after restarts.
TS_AUTHKEY=tskey-auth-xxxx
# Hostname that appears in your tailnet (e.g., media-server → media-server.your-tailnet.ts.net)
TS_HOSTNAME=media-server

# Cloudflare Tunnel — optional, for exposing a service on a public hostname
# without port forwarding. See docs/cloudflared.md.
#
# The cloudflared container sits behind the `cloudflare` Compose profile, so it
# is skipped unless you opt in here. Uncomment both lines to enable it; a token
# without the profile does nothing, and a profile without a token crash-loops.
#
# Create the tunnel at https://one.dash.cloudflare.com > Networks > Tunnels and
# copy the token out of the install command it shows you.
# COMPOSE_PROFILES=cloudflare
# CF_TUNNEL_TOKEN=eyJhIjoi...

# Stack watch — alerts for a stopped container, Jellyfin down, the host going quiet, and wanted
# titles that never download. See docs/stack-watch.md. Blank values use the defaults shown.
#
# The ntfy.sh topic to alert on. Anyone who knows the name can read and publish to it, so use a
# long random one and keep the real value out of the repo. Required.
NTFY_TOPIC=
# How long the host may go without checking in before ntfy sends "unreachable". It goes out up to
# an hour after that. A number with s/m/h/d, between 30m and 70h, or "off". Default 24h.
# 70h, not 72h: ntfy.sh schedules at most 3 days ahead and rejects a delay at the limit outright
# rather than trimming it, so the ceiling leaves the scheduling hour plus an hour of clock margin.
HEARTBEAT_GRACE=
# Free space below which the drive holding MEDIA_ROOT or SABNZBD_TEMP is reported as a problem.
# A number and M/G/T (G is 2^30 bytes, as in `df -h`), at least 1G, or "off". Default 100G, which is
# SABnzbd's own download_free floor plus the largest season this stack's quality profile grabs, so
# the alert arrives while there is still room to act. An amount rather than a percentage, so it
# still means the same thing on a bigger drive. Leaving SABNZBD_TEMP blank doesn't stop the downloads
# filesystem being watched: the check follows the same ${SABNZBD_TEMP:-/tmp/sabnzbd-temp} fallback
# docker-compose.yml mounts, unless that filesystem is smaller than this figure and so could never
# satisfy it, which the usual /tmp tmpfs is. A path you set yourself is always watched as asked.
DISK_FREE_MIN=
# Days a monitored movie or episode may be wanted with no file before the daily digest lists it.
# Default 3.
STALL_DAYS=
# Days between reminders about titles that are still waiting. Default 7.
STALL_REMIND_DAYS=
# Jellyfin's address from this host, or "off" if Jellyfin runs elsewhere.
# Default http://localhost:8096. Used by the stack watch, which runs on the host.
JELLYFIN_URL=
# Jellyfin's address from inside a container, used by the Sonarr Custom Script connector that
# heals brand-new series (scripts/install-jellyfin-refresh.sh; see docs/sonarr.md). This is a
# separate setting from JELLYFIN_URL above on purpose: that one is correct for the host and
# wrong in a container, where localhost is the container itself.
# Default http://host.docker.internal:8096, which reaches a Jellyfin on this host because
# docker-compose.yml gives sonarr a host-gateway entry. Set it when Jellyfin is elsewhere --
# including Windows-native Jellyfin with Docker Engine inside WSL, where that name is the WSL
# distro. See docs/jellyfin-library-updates.md.
JELLYFIN_INTERNAL_URL=
# An API key for that connector, made at Jellyfin's Dashboard > API Keys. Shown once, and there
# is no way to read it back, so store it here when you create it. The same key is used by the
# "Jellyfin library update" connector in Sonarr and Radarr.
JELLYFIN_ARR_API_KEY=
# The name in stack watch alert titles and in the heartbeat's ntfy sequence ID. Run
# `python3 monitoring/stack_watch.py disarm` before changing it (or the machine's hostname), or the
# "unreachable" alert scheduled under the old name still goes out. Default: the hostname.
WATCH_HOSTNAME=
# A self-hosted ntfy server for the stack watch; use https. Default https://ntfy.sh.
NTFY_SERVER=

